# 默认按 LF 检出；Windows 用户可在本地用 core.autocrlf 覆盖
* text=auto eol=lf

# 脚本与代码
*.sh   text eol=lf
*.py   text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf

# 文档与配置
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt  text eol=lf

# 二进制资源
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.wav  binary
*.wasm binary
*.swf  binary
*.asar binary

# 文档里的截图与动图
docs/images/** binary
docs/gifs/**   binary
